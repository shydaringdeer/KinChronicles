{
	"name": "@jalez/react-flow-smart-edge",
	"version": "4.0.0",
	"description": "Smart edge routing for @xyflow/react v12+ (maintained fork of @tisoap/react-flow-smart-edge)",
	"keywords": [
		"react",
		"typescript",
		"graph",
		"flow",
		"flowchart",
		"smart",
		"edge",
		"pathfinding",
		"react-flow-smart-edge",
		"xyflow",
